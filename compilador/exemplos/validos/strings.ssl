function strcmp(s1: string, s2: string, n: integer): integer
{
    var i: integer;
    i = 0;
    while (i < n && s1[i] == s2[i])
        i = i + 1;
    if (i == n)
        return 0;
    if (s1[i] < s2[i])
        return -1;
    return 1;
}

function strinv(s: string, l: integer): string
{
    var i: integer;
    i = 0;
    l = l - 1;
    while (i < l)
    {
        var c: char;
        c = s[i];
        s[i++] = s[l];
        s[l--] = c;
    }
    return s;
}
